    "test": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "fflate": "^0.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.27",
    "@eslint/js": "^8.56.0",
    "@testing-library/react": "^14.0.0",
    "@types/chrome": "^0.0.246",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.34.0",
    "prettier": "^3.2.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^7.0.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
