{
  "name": "gitleaf",
  "version": "0.2.0",
  "description": "Chrome extension to sync Overleaf projects with GitHub repositories",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx",
